{
  "manifest_version": 3,
  "name": "ChatGPT Queue",
  "version": "1.8.0",
  "description": "ChatGPT prompt queue with customizable completion sounds and stronger background attention.",
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "unlimitedStorage",
    "offscreen"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ChatGPT Queue",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}