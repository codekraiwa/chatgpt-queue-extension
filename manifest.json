{
  "manifest_version": 3,
  "name": "Prompt & Leave, ChatGPT Queue",
  "version": "1.9.5",
  "description": "Prompt & Leave queues ChatGPT prompts in strict FIFO order, tracks multiple tabs, and alerts you when work is done.",
  "permissions": [
    "storage",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Prompt & Leave, ChatGPT Queue",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
